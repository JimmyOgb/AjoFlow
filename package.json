{
  "name": "ajoflow",
  "version": "1.0.0",
  "description": "> **Autonomous, Zero-Maintenance Rotating Savings & Credit Protocol powered by Reactive Omni**",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "compile:contracts": "hardhat compile",
    "compile:reactive": "hardhat compile --config hardhat.reactive.config.js",
    "compile": "npm run compile:contracts && npm run compile:reactive",
    "lint:sol": "solhint \"contracts/src/**/*.sol\" \"reactive/src/**/*.sol\"",
    "format:check": "prettier --check \"contracts/src/**/*.sol\" \"reactive/src/**/*.sol\"",
    "format:write": "prettier --write \"contracts/src/**/*.sol\" \"reactive/src/**/*.sol\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JimmyOgb/AjoFlow.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/JimmyOgb/AjoFlow/issues"
  },
  "homepage": "https://github.com/JimmyOgb/AjoFlow#readme",
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "hardhat": "3.22.0",
    "prettier": "3.10.1",
    "prettier-plugin-solidity": "2.4.1",
    "solhint": "6.2.5"
  }
}
